<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical" >

    <LinearLayout
        android:id="@+id/linearLayout001"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/LAPI_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:textSize="13sp"
            android:layout_weight="1"
            android:text="@string/LAPI_hello"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout002"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" >

        <CheckBox
            android:id="@+id/chkCommMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:textSize="13sp"
            android:text="@string/TEXT_CHK_COMM"/>

        <CheckBox
            android:id="@+id/chkColorMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:textSize="13sp"
            android:layout_weight="1"
            android:text="@string/TEXT_CHK_COLOR"/>

        <CheckBox
            android:id="@+id/chkCheckLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:layout_weight="1"
            android:text="@string/TEXT_CHECK_LIVE"/>

        <TextView
            android:id="@+id/TextView02"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:layout_weight="0.5"
            android:text="@string/TEXT_LEVEL"/>

        <EditText
            android:id="@+id/levelText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_weight="0.5"
            android:ems="1"
            android:inputType="number"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout003"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnOpenDevice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:layout_weight="1"
            android:text="@string/TEXT_OPEN_DEVICE"/>

        <Button
            android:id="@+id/btnCloseDevice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:layout_weight="1"
            android:text="@string/TEXT_CLOSE_DEVICE"/>

        <Button
            android:id="@+id/btnGetImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:layout_weight="1"
            android:text="@string/TEXT_GET_IMAGE"/>

        <Button
            android:id="@+id/btnOnVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:layout_weight="1"
            android:text="@string/TEXT_VIDEO"/>

        <Button
            android:id="@+id/btnGetImageQuality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:layout_weight="1"
            android:text="@string/TEXT_GET_IMAGE_QUALITY"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout004"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnGetNFIQuality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:layout_weight="1"
            android:text="@string/TEXT_GET_NFI_QUALITY"/>

        <Button
            android:id="@+id/btnCreateANSITemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:layout_weight="1"
            android:text="@string/TEXT_CREATE_ANSI_TEMP"/>

        <Button
            android:id="@+id/btnCreateISOTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:layout_weight="1"
            android:text="@string/TEXT_CREATE_ISO_TEMP"/>

        <Button
            android:id="@+id/btnCompareTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:layout_weight="1"
            android:text="@string/TEXT_COMPARE_TEMP"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout005"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" >

        <TextView
            android:id="@+id/tvANSITemp"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:background="#ffdddddd"
            android:singleLine="false"
            android:layout_marginLeft="5dp"
            android:textSize="11sp"
            android:text="@string/TEXT_ANSI_CHAR"
            android:textColor="#ff000000"/>

        <TextView
            android:id="@+id/tvISOTemp"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:background="#ffdddddd"
            android:singleLine="false"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:textSize="11sp"
            android:text="@string/TEXT_ISO_CHAR"
            android:textColor="#ff000000"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout006"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp">

        <LinearLayout
            android:id="@+id/linearLayout010"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <ImageView
                android:id="@+id/imageFinger"
                android:layout_width="96dp"
                android:layout_height="135dp"
                android:background="@android:drawable/screen_background_light"
                android:baseline="1dp"
                android:contentDescription="@string/TEXT_IMAGE" />

        </LinearLayout>

        <ListView
            android:id="@+id/idListView"
            android:layout_width="0dp"
            android:layout_height="135dp"
            android:layout_weight="1"
            android:contentDescription="@string/DBLinking"
            android:drawSelectorOnTop="true"
            android:tag="@string/DBLinking"
            android:textSize="11sp"
            android:visibility="visible">

        </ListView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout007"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/HAPI_msg"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:textSize="13sp"
            android:text="@string/HAPI_hello"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/LinearLayout008"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/TextView01"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="10dp"
            android:textSize="11sp"
            android:layout_weight="0.15"
            android:text="@string/TEXT_ID"/>

        <EditText
            android:id="@+id/idText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:layout_weight="1"
            android:ems="10"
            android:inputType="text"/>

        <RadioGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_weight="1">

            <RadioButton
                android:id="@+id/rdoANSI"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:layout_marginLeft="30dp"
                android:layout_marginRight="30dp"
                android:textSize="11sp"
                android:text="@string/TEXT_RADIO_ANSI"/>

            <RadioButton
                android:id="@+id/rdoISO"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:textSize="11sp"
                android:text="@string/TEXT_RADIO_ISO"/>
        </RadioGroup>

    </LinearLayout>

    <LinearLayout
            android:id="@+id/linearLayout009"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnEnroll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:layout_weight="1"
                android:text="@string/TEXT_ENROLL"/>

            <Button
                android:id="@+id/btnVerify"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:layout_weight="1"
                android:text="@string/TEXT_VERIFY"/>

            <Button
                android:id="@+id/btnSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:layout_weight="1"
                android:text="@string/TEXT_SEARCH"/>

            <Button
                android:id="@+id/btnDBRefresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:layout_weight="1"
                android:text="@string/TEXT_DB_REFRESH"/>

            <Button
                android:id="@+id/btnDBClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:layout_weight="1"
                android:text="@string/TEXT_DB_CLEAR"/>

            <Button
                android:id="@+id/btnRCDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:layout_weight="1"
                android:text="@string/TEXT_DEL_RECORD"/>

        </LinearLayout>


</LinearLayout>
